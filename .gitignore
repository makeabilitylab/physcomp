# Originally modified from: https://github.com/mmistakes/minimal-mistakes/blob/master/.gitignore

# Sublime Text
*.sublime-project
*.sublime-workspace

# Ruby Gem
*.gem
.bundle
Gemfile.lock
vendor/bundle

# Node.js and NPM
node_modules
npm-debug.log*
package-lock.json
codekit-config.json

# macOS
.DS_Store

# Generated at build time by the Actions deploy (Stamp build version step);
# never commit it. version.json renders from it. See .github/workflows/jekyll.yml.
_data/version.yml

# Jekyll generated files
.jekyll-cache
.jekyll-metadata
.sass-cache
_asset_bundler_cache
_site
assets/calculations/~$PullUpResistor.xlsx
assets/calculations/~$PullUpResistor_v2.xlsx
assets/calculations/~$NoisyDataFiltering.xlsx
assets/calculations/~$TransistorVibromotorCalculations.xlsx
